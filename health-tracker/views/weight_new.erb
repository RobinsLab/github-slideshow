<h2>体重を記録</h2>

<form action="/weights" method="post">
  <label>
    タイミング
    <select name="time_of_day">
      <option value="morning" <%= "selected" if @time_of_day == "morning" %>>朝(食前)</option>
      <option value="night" <%= "selected" if @time_of_day == "night" %>>夜(就寝前)</option>
    </select>
  </label>

  <label>
    体重 (kg)
    <input type="number" step="0.1" name="weight_kg" required>
  </label>

  <label>
    メモ(任意)
    <input type="text" name="note">
  </label>

  <button type="submit" class="button primary">記録する</button>
</form>
