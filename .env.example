# Claude API key (required for article recommendation and script generation)
ANTHROPIC_API_KEY=your_api_key_here

# TTS voice settings (optional)
# Japanese voice: ja-JP-NanamiNeural (female), ja-JP-KeitaNeural (male)
# English voice: en-US-JennyNeural (female), en-US-GuyNeural (male)
TTS_VOICE_JA=ja-JP-NanamiNeural
TTS_VOICE_EN=en-US-JennyNeural

# Output directory
OUTPUT_DIR=./output
